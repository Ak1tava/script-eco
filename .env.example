# Docker Compose uses these values. Do not use real sensor secrets in a public repository.
POSTGRES_DB=ecology
POSTGRES_USER=ecology
POSTGRES_PASSWORD=ecology_local_password
DATABASE_URL=postgresql+psycopg2://ecology:ecology_local_password@db:5432/ecology
SIMULATOR_INTERVAL_SECONDS=30
VITE_API_URL=http://localhost:8000/api/v1

